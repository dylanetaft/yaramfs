#!/bin/sh
# PID 1 inside the initramfs — same hook runner as host runme.sh.
# Owns switch_root and the recovery shell (hooks only mount/export NEWROOT).
export PATH=/bin:/sbin
YARAMFS_CFG_CONFIG_DIR=/hooks
export YARAMFS_CFG_CONFIG_DIR

# Early /tmp so for_each_hook can use /tmp/yaramfs_exports before base mounts.
mkdir -p /tmp

. /hooks/shared/head.sh

# Resolve NEWROOT/INIT from PID 1 state (not child-shell env).
# Order: YARAMFS_CFG_BOOT_NEWROOT → /tmp/yaramfs_newroot → NEWROOT_MNT|/mnt/root.
# Optional init: YARAMFS_CFG_BOOT_INIT → /tmp/yaramfs_init → /sbin/init.
# Sets _tsr_newroot and _tsr_init. Returns 0 if ${NEWROOT}${INIT} exists.
try_switch_root_resolve() {
  _tsr_newroot=
  _tsr_init=

  if [ -n "${YARAMFS_CFG_BOOT_NEWROOT:-}" ]; then
    _tsr_newroot=${YARAMFS_CFG_BOOT_NEWROOT}
  elif [ -r /tmp/yaramfs_newroot ]; then
    _tsr_newroot=$(sed -n '1p' /tmp/yaramfs_newroot | tr -d '\r')
  else
    _tsr_newroot=${YARAMFS_CFG_BOOT_NEWROOT_MNT:-/mnt/root}
  fi

  if [ -n "${YARAMFS_CFG_BOOT_INIT:-}" ]; then
    _tsr_init=${YARAMFS_CFG_BOOT_INIT}
  elif [ -r /tmp/yaramfs_init ]; then
    _tsr_init=$(sed -n '1p' /tmp/yaramfs_init | tr -d '\r')
  else
    _tsr_init=/sbin/init
  fi

  [ -n "${_tsr_newroot}" ] || return 1
  [ -e "${_tsr_newroot}${_tsr_init}" ] || return 1
  return 0
}

# Move virt fs into newroot and exec switch_root. Returns 1 only if not ready
# or switch_root failed (exec does not return on success).
try_switch_root_from_state() {
  if ! try_switch_root_resolve; then
    return 1
  fi

  _nr=${_tsr_newroot}
  _init=${_tsr_init}

  for _d in proc sys dev run; do
    if [ -d "${_nr}/${_d}" ] && mountpoint -q "/${_d}" 2>/dev/null; then
      mount --move "/${_d}" "${_nr}/${_d}" 2>/dev/null \
        || mount -o bind "/${_d}" "${_nr}/${_d}" 2>/dev/null \
        || true
    fi
  done

  echo "yaramfs: switch_root ${_nr} ${_init}" >&2
  exec switch_root "${_nr}" "${_init}"

  echo "yaramfs: switch_root failed: ${_nr} ${_init}" >&2
  return 1
}

print_recovery_banner() {
  echo "yaramfs: recovery shell (/init remains PID 1; this shell is a child)" >&2
  echo "yaramfs:   Mount real root on /mnt/root (or write path to /tmp/yaramfs_newroot)." >&2
  echo "yaramfs:   Ensure .../sbin/init exists (or write path to /tmp/yaramfs_init)." >&2
  echo "yaramfs:   Exit the shell to attempt switch_root; if not ready, shell opens again." >&2
}

# Foreground child only — never exec over PID 1 (exit would panic the kernel).
# Plain sh is enough: /init waits, then retries switch_root. No setsid (-w is
# util-linux only; busybox setsid may also return before the shell exits).
recovery_shell_child() {
  echo "yaramfs: dropping to recovery shell" >&2
  trap '' INT
  trap '' QUIT

  if [ -c /dev/console ]; then
    sh -i <>/dev/console 2>&1
  else
    sh -i
  fi
}

# Boot hooks run as children; /init stays PID 1 for rescue + switch_root.
_boot_hooks_ok=1
if ! for_each_hook boot; then
  echo "yaramfs: boot hooks failed" >&2
  _boot_hooks_ok=0
fi

trap '' INT
trap '' QUIT

# If any boot hook failed, open recovery at least once even when NEWROOT is
# already mounted (e.g. boot-force-debug after a successful boot-root). Exit
# the shell to retry switch_root. Clean boot: switch_root immediately when ready.
while :; do
  if [ "${_boot_hooks_ok}" -eq 1 ] && try_switch_root_from_state; then
    : # unreachable: success is exec switch_root
  fi
  _boot_hooks_ok=1
  print_recovery_banner
  recovery_shell_child
done
